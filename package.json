{
  "name": "depug",
  "version": "0.1.0",
  "description": "Measure runtime values in TypeScript test runs instead of guessing them from source.",
  "keywords": [
    "typescript",
    "testing",
    "vitest",
    "debugging",
    "instrumentation",
    "test-runner",
    "ai-agents",
    "coding-agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/meganemura/depug#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meganemura/depug.git"
  },
  "bugs": {
    "url": "https://github.com/meganemura/depug/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./reporter": {
      "types": "./dist/src/reporter.d.ts",
      "default": "./dist/src/reporter.js"
    },
    "./node-test-reporter": {
      "types": "./dist/src/node-test-reporter.d.ts",
      "default": "./dist/src/node-test-reporter.js"
    },
    "./plugin": {
      "types": "./dist/src/plugin.d.ts",
      "default": "./dist/src/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "depug": "./dist/bin/depug.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "skills",
    "docs",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "typescript": ">=5.5.4 <7.0.0"
  },
  "devDependencies": {
    "@hegeldev/hegel": "0.4.5",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
