{
  "name": "depug",
  "version": "0.0.0",
  "private": true,
  "description": "Measure runtime values in TypeScript test runs instead of guessing them from source.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./reporter": "./src/reporter.ts",
    "./plugin": "./src/plugin.ts",
    "./package.json": "./package.json",
    "./node-test-reporter": "./src/node-test-reporter.ts"
  },
  "bin": {
    "depug": "./bin/depug.ts"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "docs",
